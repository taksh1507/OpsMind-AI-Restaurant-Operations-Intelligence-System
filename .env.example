# OpsMind AI - Environment Configuration Template
# SECURITY: This is a template. Copy to .env and update with REAL VALUES.
# .env is .gitignored and NEVER committed to version control.

# ============================================================================
# DATABASE CONFIGURATION (Required - for Docker Compose)
# ============================================================================
DB_NAME=opsmind_ai
DB_USER=opsmind_admin
DB_PASSWORD=CHANGE_ME_TO_VERY_SECURE_PASSWORD_MIN_12_CHARS
DB_PORT=5432

# API Database URL (constructed from above - DO NOT use defaults in production)
DATABASE_URL=postgresql+asyncpg://opsmind_admin:CHANGE_ME_TO_VERY_SECURE_PASSWORD_MIN_12_CHARS@db:5432/opsmind_ai

# ============================================================================
# SECURITY CONFIGURATION (REQUIRED)
# ============================================================================
# Generate secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_USING_SECRETS_MODULE_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
APP_NAME=OpsMind AI
APP_VERSION=1.0.0
DEBUG=False  # NEVER set to True in production

# CORS Origins (allowed domains)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://localhost:8000"]

# ============================================================================
# AI CONFIGURATION (REQUIRED for AI features)
# ============================================================================
# Primary LLM: Anthropic Claude (claude-opus-4-8).
#
# Provide EITHER an API key OR an auth token:
#   - ANTHROPIC_API_KEY    -> official Anthropic API (https://api.anthropic.com)
#                             Get a key at https://console.anthropic.com/
#   - ANTHROPIC_AUTH_TOKEN -> bearer token for an Anthropic-compatible
#                             gateway/proxy (used with ANTHROPIC_BASE_URL below)
ANTHROPIC_API_KEY=CHANGE_ME_GET_FROM_https://console.anthropic.com/
# ANTHROPIC_AUTH_TOKEN=CHANGE_ME_BEARER_TOKEN_FROM_YOUR_GATEWAY_PROVIDER
ANTHROPIC_MODEL=claude-opus-4-8

# Optional: point the client at an Anthropic-COMPATIBLE endpoint instead of the
# official API. Leave UNSET to use https://api.anthropic.com.
#
#  SECURITY WARNING: A non-official base URL (e.g. a third-party proxy such as
#  https://api.justwoker.icu) receives EVERY prompt this app sends -- including
#  your restaurant's sales, cost, margin and customer data -- plus the auth
#  token above. Only set this to an endpoint you fully trust and control.
#  Third-party Claude proxies may also violate Anthropic's Terms of Service.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# [DEPRECATED] Google Gemini is no longer used by the AI agent.
# GEMINI_API_KEY=CHANGE_ME_GET_FROM_https://ai.google.dev/
OPENWEATHER_API_KEY=CHANGE_ME_GET_FROM_https://openweathermap.org/

# ----------------------------------------------------------------------------
# AI usage guardrail (Phase 4)
# ----------------------------------------------------------------------------
# Per-restaurant (tenant) monthly AI token cap, counting input + output tokens
# across ALL AI features within the current UTC month. When a restaurant reaches
# the cap, its AI endpoints return HTTP 429 until the next month begins. The
# Owner can watch usage at GET /api/v1/ai-usage.
# Set to 0 (or a negative number) to disable enforcement entirely.
AI_MONTHLY_TOKEN_CAP=1500000

# ============================================================================
# PRODUCTION DEPLOYMENT SECURITY CHECKLIST
# ============================================================================
# ✅ Use strong passwords (16+ chars, uppercase, lowercase, numbers, symbols)
# ✅ Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ✅ Use environment variable management (AWS Secrets Manager, HashiCorp Vault)
# ✅ Never hardcode passwords in docker-compose.yml (use .env)
# ✅ Rotate credentials every 90 days
# ✅ Never commit .env files to git
# ✅ Use separate credentials for dev/staging/production
# ✅ Enable audit logging for credential access
# ✅ Use IAM roles instead of API keys where possible
# ✅ Implement credential rotation policies

